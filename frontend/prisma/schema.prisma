generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  // Nullable: OAuth-only users (e.g. signed up with Google) never set a
  // password. Email/password signup still requires it; the auth route
  // enforces presence at runtime.
  passwordHash      String?
  emailVerifiedAt   DateTime?
  tokenVersion      Int       @default(0)
  withdrawalPinHash String? // bcrypt hash of withdrawal PIN; null = no PIN set
  // Optional display name — populated from OAuth profile on first sign-in.
  // Email/password users can fill it later via /api/auth/me PATCH (future).
  name              String?
  // Optional avatar URL — populated from OAuth profile on first sign-in.
  avatarUrl         String?
  // App-wide role. USER is the default; ADMIN unlocks /admin back-office;
  // SUPERADMIN can promote/demote other admins. Bootstrap an initial
  // SUPERADMIN via `pnpm db:make-superadmin <email>` (see scripts).
  role              String    @default("USER") // USER | ADMIN | SUPERADMIN
  // Account status. ACTIVE = login + refresh allowed; SUSPENDED = both
  // refused with 403 ACCOUNT_SUSPENDED. Mutated via /api/admin/users/[id]/status
  // (ADMIN can suspend; only SUPERADMIN can restore).
  status            String    @default("ACTIVE") // ACTIVE | SUSPENDED
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  verificationCodes VerificationCode[]
  uploads           FileUpload[]
  notifications     Notification[]
  notifPrefs        NotificationPreferences?
  orders            Order[]
  withdrawals       Withdrawal[]
  oauthAccounts     OAuthAccount[]
  adminActions      AdminAction[]

  // Multi-tenancy is opt-in per project: by default no resource is org-scoped.
  // Apps that need it (marketplace, B2B SaaS, classifieds) wire owner relations
  // on their domain models.
  ownedOrganizations Organization[]      @relation("OrgOwner")
  memberships        OrganizationMember[] @relation("OrgMembership")

  // VipInvitoz domain
  subscription      Subscription?
  ceremonies        Ceremony[]
  aiGenerations     AiGeneration[]
  // Optional phone for SMS OTP fallback when email is missing. Format E.164.
  phone             String?   @unique
  phoneVerifiedAt   DateTime?
  // Interface language choice (FR default). Changeable via settings.
  locale            String    @default("fr") // fr | en | de

  @@index([email])
  @@index([role])
  @@index([status])
}

// ───────────────────────────────────────────────────────────────────────
// Admin audit log — every back-office mutation is recorded here so we can
// answer "who did what when" during incidents / compliance reviews.
//
// `action` is a free-form dotted string the UI groups by (e.g.
// "withdrawal.cancel", "user.role_change", "order.refund").
// `targetType` + `targetId` reference the affected row when applicable.
// `metadata` carries the diff or extra context as JSON.
//
// Retention: not pruned automatically (compliance). If your jurisdiction
// requires deletion after N years, add a cron in backend/src/index.ts
// modeled on the WebhookLog purge.
// ───────────────────────────────────────────────────────────────────────
model AdminAction {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}

// ───────────────────────────────────────────────────────────────────────
// Multi-tenancy primitives — opt-in.
//
// Default project surface stays user-owned (`Order.userId`, `Withdrawal.userId`).
// Apps that need orgs add `organizationId String?` to their domain models
// case by case and use `requireOrgRole()` middleware to gate access.
//
// Slug must be unique app-wide (not just within an owner) so it can be
// used as a stable URL segment.
// ───────────────────────────────────────────────────────────────────────
model Organization {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  ownerId   String
  owner     User     @relation("OrgOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members   OrganizationMember[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

// Role precedence: OWNER > ADMIN > MEMBER. The owner is also a member row
// (created in the same tx as the org) so list-my-orgs queries can join
// uniformly via memberships.
model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("OrgMembership", fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("MEMBER") // OWNER | ADMIN | MEMBER
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([userId])
}

// ───────────────────────────────────────────────────────────────────────
// OAuth identities — one User can have N linked providers (Google, GitHub, …).
// (provider, providerAccountId) is unique so the same Google account can't
// link twice. Email matching at sign-in is intentional: if a user signed up
// with email/password and later "Sign in with Google" using the same email,
// we link the Google account to the existing user instead of creating a
// duplicate (see backend/src/routes/oauth.ts).
// ───────────────────────────────────────────────────────────────────────
model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String // "google" | "github" | …
  providerAccountId String // sub from the OIDC ID token
  // Optional refresh token (encrypted at rest if you store one) — Google
  // only returns it on first consent with `access_type=offline`. Most
  // boilerplate flows don't need it; we keep the column for future use.
  refreshToken      String?
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model VerificationCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  type      String // EMAIL_VERIFY | PASSWORD_RESET
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([userId, type])
  @@index([code, type])
}

// ───────────────────────────────────────────────────────────────────────
// File uploads — Cloudinary (column names kept from the R2 era; no migration needed)
// ───────────────────────────────────────────────────────────────────────
model FileUpload {
  id        String   @id @default(cuid())
  userId    String? // nullable — uploads can be anonymous if route allows
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  key       String   @unique // Cloudinary public_id (column name historical — was R2 object key)
  filename  String
  mimeType  String
  sizeBytes Int
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 2 — durable email queue rows
// ───────────────────────────────────────────────────────────────────────
model EmailJob {
  id          String    @id @default(cuid())
  to          String
  subject     String
  html        String
  text        String?
  status      String    @default("PENDING") // PENDING | SENT | FAILED | DEAD
  attempts    Int       @default(0)
  lastError   String?
  scheduledAt DateTime  @default(now())
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, scheduledAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 2 — notifications (at-most-once via dedupeKey)
// ───────────────────────────────────────────────────────────────────────
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  data      Json?
  dedupeKey String    @unique
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model NotificationPreferences {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // JSON map of { eventType: { email: bool, inApp: bool } } — flexible without migrations.
  prefs     Json     @default("{}")
  updatedAt DateTime @updatedAt
}

// ───────────────────────────────────────────────────────────────────────
// Outbox — durable side-effects (notifications, emails) emitted from
// inside transactions (e.g. webhook handlers, withdrawal flow). Side-effect
// rows are inserted in the same tx as the state change, then a worker
// drains them. Survives crashes the previous postCommit-callback pattern
// silently dropped.
//
// `kind` is a free-form string the dispatcher routes on
// (e.g. "notification.payment_received", "email.payment_confirmation").
// ───────────────────────────────────────────────────────────────────────
model OutboxEvent {
  id          String    @id @default(cuid())
  kind        String
  payload     Json
  status      String    @default("PENDING") // PENDING | SENT | FAILED | DEAD
  attempts    Int       @default(0)
  lastError   String?
  scheduledAt DateTime  @default(now())
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, scheduledAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 2 — webhook idempotency log
// ───────────────────────────────────────────────────────────────────────
model WebhookLog {
  id          String    @id @default(cuid())
  provider    String
  externalId  String
  eventType   String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([externalId, eventType])
  @@index([provider, createdAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 3 — payments (Order + Withdrawal)
//
// `amount` is stored in the smallest unit of `currency` (no decimals).
// For XOF (FCFA, Senegal) that's 1 = 1 FCFA. For USD adapt to cents
// at the call site — the schema is currency-agnostic.
// ───────────────────────────────────────────────────────────────────────
model Order {
  id              String    @id @default(cuid())
  userId          String? // nullable — guest checkout supported
  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  amount          Int // gross amount, smallest unit
  currency        String    @default("XOF") // ISO 4217
  status          String    @default("PENDING") // PENDING | PAID | EXPIRED | FAILED | REFUNDED
  customerEmail   String?
  customerPhone   String?
  customerName    String?
  metadata        Json? // app-specific fields

  // Stripe-grade idempotency. Required header on POST /api/orders; replay
  // with same value returns the original Order row instead of double-charging.
  // Nullable so existing rows pre-migration don't break the @unique constraint.
  idempotencyKey  String?   @unique

  // Provider reference
  provider         String // e.g. "bictorys"
  providerChargeId String? @unique
  paymentUrl       String? // checkout/redirect URL returned by provider
  paymentMethod    String? // WAVE | ORANGE_MONEY | FREE_MONEY (set on PAID by webhook)

  // Optional commission (for marketplace-style apps)
  commissionAmount Int?
  netAmount        Int?

  // Lifecycle
  expiresAt DateTime // PENDING expiry; not cleared on PAID (history)
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@index([provider, providerChargeId])
}

model Withdrawal {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  amount      Int // requested amount, smallest unit
  currency    String   @default("XOF")
  status      String   @default("PENDING") // PENDING | PROCESSING | COMPLETED | FAILED | CANCELLED
  destination Json // { method: "WAVE" | "ORANGE_MONEY" | ..., phone: "+221...", accountName?: "..." }

  // Provider reference
  provider         String // e.g. "bictorys"
  providerPayoutId String? @unique
  failureReason    String?

  requestedAt DateTime  @default(now())
  processedAt DateTime?
  completedAt DateTime?

  @@index([userId, requestedAt])
  @@index([status, requestedAt])
  @@index([provider, providerPayoutId])
}

// ═════════════════════════════════════════════════════════════════════════
// VipInvitoz domain — ceremony organization
// ═════════════════════════════════════════════════════════════════════════

// ─── Subscription ──────────────────────────────────────────────────────
// One active subscription per user (unique by userId). Tier drives quotas:
//   FREEMIUM : 1 cérémonie, 20 invités max, 6 crédits IA
//   PREMIUM  : cérémonies illimitées, invités illimités, 12 crédits IA + chatbot,
//              plan de table, projection live, livre d'or
//   VIP      : tout Premium + modif IA illimitées, budget, prestataires, orientation
// Renouvellement MANUEL trimestriel (PRD §6) — pas d'autorenew en V1.
// orderId lie la souscription active à l'Order de paiement qui l'a créée.
model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier                 String    @default("FREEMIUM") // FREEMIUM | PREMIUM | VIP
  status               String    @default("ACTIVE") // ACTIVE | EXPIRED | CANCELLED
  startedAt            DateTime  @default(now())
  // Null pour FREEMIUM (jamais expiré). Daté pour PREMIUM/VIP (fin de trimestre).
  expiresAt            DateTime?
  // Crédits IA restants pour le trimestre courant. -1 = illimité (VIP).
  // Reset à chaque renouvellement.
  aiCreditsRemaining   Int       @default(6)
  // Nombre max de cérémonies simultanées. 1 = Freemium+Premium, -1 = VIP illimité.
  // (La règle Premium/VIP multi-cérémonie est arbitrée côté app en lisant tier.)
  maxCeremonies        Int       @default(1)
  // Référence au dernier Order réglé qui a activé / renouvelé la souscription.
  orderId              String?   @unique
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([tier, status])
  @@index([status, expiresAt])
}

// ─── Ceremony ──────────────────────────────────────────────────────────
// Événement racine : mariage, baptême, anniversaire, deuil, autre.
// Possède N `CeremonyOccasion` pour supporter plusieurs dates/lieux
// (ex: mariage civil + religieux + réception — PRD §4 "Création & gestion").
// status DRAFT → ACTIVE (invitations envoyables) → PAST (date dépassée)
//                      → ARCHIVED (effacée par l'orga).
model Ceremony {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           String // MARIAGE | BAPTEME | ANNIVERSAIRE | DEUIL | AUTRE
  title          String // ex: "Mariage de Fatoumata & Ibrahima"
  // Description libre (1 phrase) utilisée comme prompt pour la génération IA.
  description    String
  status         String   @default("DRAFT") // DRAFT | ACTIVE | PAST | ARCHIVED
  coverImageUrl  String?
  // Fichier musical de fond pour la page invitation (Cloudinary URL).
  musicUrl       String?
  musicLabel     String? // ex: "Jazz africain doux"
  // Résultat de la génération IA — stocké en JSON pour pouvoir éditer
  // par bloc sans re-générer tout. Structure : { blocks: [...] }
  invitationJson Json?
  // Compteur de modifications IA consommées sur cette cérémonie.
  aiModCount     Int      @default(0)

  occasions        CeremonyOccasion[]
  guests           Guest[]
  invitations      Invitation[]
  aiGens           AiGeneration[]
  guestbookEntries GuestbookEntry[]
  seatingTables    SeatingTable[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, createdAt])
}

// ─── CeremonyOccasion ──────────────────────────────────────────────────
// Une date+lieu dans une cérémonie. Minimum 1 par cérémonie.
// Ex pour un mariage : "Cérémonie civile" (14 juin 15h, mairie), "Religieuse"
// (14 juin 17h, église), "Réception" (14 juin 20h, Terrou-Bi).
// `order` sert au tri d'affichage (0 = premier).
model CeremonyOccasion {
  id              String   @id @default(cuid())
  ceremonyId      String
  ceremony        Ceremony @relation(fields: [ceremonyId], references: [id], onDelete: Cascade)
  label           String // ex: "Cérémonie civile", "Réception"
  startsAt        DateTime
  // Durée optionnelle (minutes). Null si non précisé.
  durationMinutes Int?
  locationName    String // ex: "Hôtel Terrou-Bi"
  locationAddress String
  // Lat/lng pour deeplink navigation. Null si non géocodé.
  locationLat     Float?
  locationLng     Float?
  // Instructions libres pour l'invité ("Parking à droite après le portail bleu").
  instructions    String?
  order           Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ceremonyId, order])
}

// ─── Guest ─────────────────────────────────────────────────────────────
// Liste des invités d'une cérémonie (sans compte utilisateur requis).
// phone est le canal principal (WhatsApp), email optionnel.
// (ceremonyId, phone) unique pour éviter les doublons sur le même événement.
model Guest {
  id         String   @id @default(cuid())
  ceremonyId String
  ceremony   Ceremony @relation(fields: [ceremonyId], references: [id], onDelete: Cascade)
  name       String
  phone      String? // E.164 recommandé
  email      String?
  notes      String?

  // Nullable: a guest without a table is "unassigned". onDelete SetNull so
  // dropping a table doesn't cascade-delete its guests — they just become
  // unassigned.
  seatingTableId String?
  seatingTable   SeatingTable? @relation(fields: [seatingTableId], references: [id], onDelete: SetNull)

  invitations Invitation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ceremonyId, phone])
  @@index([ceremonyId])
  @@index([seatingTableId])
}

// ─── Invitation ────────────────────────────────────────────────────────
// Instance d'invitation envoyée à un Guest. Un Guest peut recevoir plusieurs
// invitations (ex: relance). `slug` est l'URL opaque publique /i/[slug].
// `qrToken` est un identifiant court pour le QR code (scan jour J).
// RSVP et check-in sont attachés ici — un invité = une invitation active.
model Invitation {
  id         String   @id @default(cuid())
  ceremonyId String
  ceremony   Ceremony @relation(fields: [ceremonyId], references: [id], onDelete: Cascade)
  guestId    String
  guest      Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)

  // URL publique /i/[slug] — opaque (nanoid 12 chars par défaut).
  slug     String  @unique
  // QR code identifier (nanoid 10 chars). Imprimable séparément.
  qrToken  String  @unique
  // Canal d'envoi utilisé. Null = pas encore envoyée.
  channel  String? // WHATSAPP | LINK | EMAIL | SMS
  sentAt   DateTime?
  viewedAt DateTime? // 1ère ouverture de la page /i/[slug]

  rsvpStatus     String    @default("PENDING") // PENDING | CONFIRMED | DECLINED
  rsvpAt         DateTime?
  // 0 = l'invité vient seul ; N = N accompagnants en plus de lui-même.
  companionCount Int       @default(0)

  // Jour J — scan QR
  checkedInAt       DateTime?
  checkedInByUserId String?

  guestbookEntries GuestbookEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ceremonyId, rsvpStatus])
  @@index([ceremonyId, checkedInAt])
  @@index([guestId])
}

// ─── AiGeneration ──────────────────────────────────────────────────────
// Audit log des appels Claude (coûts + anti-abus + debug prompt engineering).
// kind : INITIAL (première génération), MODIFICATION (modif ponctuelle),
// CHATBOT (tour de chat Premium/VIP). costCents pour reporting.
model AiGeneration {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ceremonyId String?
  ceremony   Ceremony? @relation(fields: [ceremonyId], references: [id], onDelete: SetNull)
  kind       String // INITIAL | MODIFICATION | CHATBOT
  model      String // ex: "claude-sonnet-5-5"
  prompt     String
  response   String
  // Tokens from provider response.
  inputTokens  Int
  outputTokens Int
  // Coût estimé en centimes de centime (1000 = 1 cent). Permet de tracker
  // sans arrondi au call et de sommer précisément par user/mois.
  costMicrocents Int
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@index([ceremonyId, kind])
}

// ─── GuestbookEntry ────────────────────────────────────────────────────
// Un message laissé par un invité dans le livre d'or d'une cérémonie.
// Texte uniquement (le vocal/vidéo a été retiré du périmètre V1).
//
// `invitationId` est optionnel : un invité peut poster sans Invitation
// identifiée (ex: ajouté manuellement par l'organisateur au jour J).
// Si Invitation présente, suppression = SetNull plutôt que Cascade pour
// garder la trace du message même si l'invitation est supprimée.
//
// `pinnedAt` : l'organisateur peut épingler un message depuis le
// dashboard /guestbook (bouton "Épingler" déjà présent dans l'UI).
model GuestbookEntry {
  id           String      @id @default(cuid())
  ceremonyId   String
  ceremony     Ceremony    @relation(fields: [ceremonyId], references: [id], onDelete: Cascade)
  invitationId String?
  invitation   Invitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)

  authorName String
  content    String
  pinnedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([ceremonyId, createdAt])
  @@index([ceremonyId, pinnedAt])
  @@index([invitationId])
}

// ─── SeatingTable ──────────────────────────────────────────────────────
// Tables of the seating plan for a ceremony. `capacity` is the max count
// (soft cap: UI warns but doesn't block over-seating — the organiser knows
// their situation better than we do). `order` controls display order on
// the /seating dashboard. Guests link back via Guest.seatingTableId (nullable).
model SeatingTable {
  id         String   @id @default(cuid())
  ceremonyId String
  ceremony   Ceremony @relation(fields: [ceremonyId], references: [id], onDelete: Cascade)

  label    String
  capacity Int    @default(8)
  order    Int    @default(0)

  guests Guest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ceremonyId, order])
}
